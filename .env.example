# ─── LiveKit Cloud ───────────────────────────────────────────────────────────
# https://cloud.livekit.io → your project → Settings → Keys
# Also bills the speech-to-text, LLM and voice (LiveKit Inference).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Synthesia Interactive Avatars ───────────────────────────────────────────
# https://app.synthesia.io → API keys (scoped to Interactive Avatars). Server-only.
SYNTHESIA_API_KEY=
# Interactive ID of a synthetic or personal avatar. Default: Mei.
# SYNTHESIA_AVATAR_ID=4b638067-6319-46e1-b634-371a4bdfceb9

# ─── Malitos agent worker (agent/agent.py) ───────────────────────────────────
# Shared secret the worker uses to call /api/agent/*. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SHARED_SECRET=
# Where the worker reaches this Next.js app.
APP_URL=http://localhost:3000
# Optional overrides
# LIVEKIT_AGENT_NAME=malitos
# AGENT_LLM_MODEL=openai/gpt-4.1
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# ─── Clerk ───────────────────────────────────────────────────────────────────
# Keys: https://clerk.com/ → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk API endpoints (found in Dashboard → API Keys → Advanced)
NEXT_PUBLIC_CLERK_DOMAIN=https://your-app.clerk.accounts.dev
CLERK_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Clerk JWT public key (Dashboard → API Keys → Advanced → JWKS Public Key)
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your_public_key_here
-----END PUBLIC KEY-----"

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
