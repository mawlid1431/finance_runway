
# ─── Runway ──────────────────────────────────────────────────────────────────
# API key: https://app.runwayml.com/ → API Keys
RUNWAYML_API_SECRET=your_runway_api_secret_here

# Character ID: https://dev.runwayml.com/ → Characters → your character → copy ID
NEXT_PUBLIC_RUNWAY_CHARACTER_ID=your_character_id_here

# ─── Clerk ───────────────────────────────────────────────────────────────────
# Keys: https://clerk.com/ → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk API endpoints (found in Dashboard → API Keys → Advanced)
NEXT_PUBLIC_CLERK_DOMAIN=https://your-app.clerk.accounts.dev
CLERK_API_URL=https://api.clerk.com
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Clerk JWT public key (Dashboard → API Keys → Advanced → JWKS Public Key)
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
your_public_key_here
-----END PUBLIC KEY-----"

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
